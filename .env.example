# Copy to `.env` and fill in. All six are declared in astro.config.mjs under `env.schema`
# with `validateSecrets: true`, so the four secrets must be present (even if empty) or
# `astro dev` / `astro build` will fail at startup.
#
# Real values live in Netlify. To pull them:
#   npx netlify-cli login
#   npx netlify-cli link
#   npx netlify-cli env:list --plain --context production

# Public — these are the real values, no secret involved.
PUBLIC_SANITY_STUDIO_PROJECT_ID=hr4xqyhv
PUBLIC_SANITY_STUDIO_DATASET=production

# Sanity read token from sanity.io/manage → API → Tokens (Viewer scope is enough).
# Optional for `astro dev` — the `production` dataset allows anonymous reads of published
# content — but REQUIRED for `astro build`, which rejects an empty value as missing.
# Leave EMPTY rather than putting in a placeholder: Sanity 401s on a bad token, so a fake
# value breaks content fetching that would otherwise work.
SANITY_STUDIO_SECRET_TOKEN=

# HMAC key for the Altcha proof-of-work challenge. Minted in
# src/pages/api/altcha/challenge.ts and verified in src/lib/altcha.ts with the same key,
# so any random string works locally: `openssl rand -hex 32`
ALTCHA_API_KEY=

# Resend — needed only for the contact/subscribe forms to actually send.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
