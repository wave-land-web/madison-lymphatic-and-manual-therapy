---
import { getImage } from 'astro:assets'
import CourtneyImage from '../assets/images/lsom-courtney.jpg'
import ElizabethImage from '../assets/images/lsom-elizabeth.jpg'
import SarahImage from '../assets/images/lsom-sarah.jpg'
import PlaceholderOneImage from '../assets/images/placeholder-1.jpg'
import ListItem from '../components/text/ListItem.astro'
import PageTitle from '../components/text/PageTitle.astro'
import Card from '../components/ui/Card.astro'
import PageHeader from '../components/ui/PageHeader.astro'
import ThemedSection from '../components/ui/ThemedSection.astro'
import { SITE_TITLE } from '../consts'
import Layout from '../layouts/Layout.astro'
import TeamBioCard from '../components/ui/TeamBioCard.astro'

const placeholderOneImage = await getImage({ src: PlaceholderOneImage })
---

<Layout
  title={`Our Team | ${SITE_TITLE}`}
  description="Meet the compassionate and experienced team at Lymphatic Specialists of Madison."
>
  <PageHeader>
    {/*
      Team hero image removed 2026-09-03, pending a replacement photo. Commit 28b8b6d has
      the previous two-column layout in full — the <Image> markup, its GroupImage import,
      the Image import from astro:assets, and the split mobile/desktop Book Now buttons.
      Restore from there rather than from memory. The photo is kept at
      src/assets/images/lsom-group.jpg.
    */}
    <div class="container w-full flex justify-center mx-auto">
      <div
        class="flex flex-col items-center gap-(--site-padding-sm) text-center mx-auto"
      >
        <PageTitle>Our Team</PageTitle>
        <p class="h2 mb-(--site-padding-sm) lsa lsa-slide-up delay-100 no-repeat">
          Experience and Compassion
        </p>
        <p class="lsa mb-(--site-padding-sm) lsa-slide-up delay-200 no-repeat">
          The therapists at Lymphatic Specialists of Madison believe that care should always be
          holistic and interdisciplinary, and we strive to help guide you towards healing with
          experience and compassion. With over 35 years of combined clinical experience, two
          master's degrees, and a doctorate, the team at Lymphatic Specialists of Madison provides
          expert, evidence-based care you can trust. Each practitioner is certified in the Vodder
          technique of Manual Lymphatic Drainage Massage through Klose Training and applies a deep
          understanding of anatomy and physiology to deliver highly personalized treatment.
        </p>
        <div class="lsa lsa-slide-up delay-300 no-repeat">
          <a
            href="https://booksy.com/en-us/1554807_lymphatic-specialists-of-madison_massage_39663_madison#ba_s=sh_1"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary"
          >
            Book Now
          </a>
        </div>
      </div>
    </div>
  </PageHeader>

  <main>
    <!-- Team Members Section -->
    <section id="team-members" class="pt-0">
      <div class="wrapper container flex flex-col gap-(--site-padding-md) mx-auto">
        <h2 class="h1 text-primary lsa lsa-slide-up no-repeat">Meet the Team</h2>

        <!-- Courtney Rolnick -->
        <div class="lsa lsa-slide-up no-repeat group">
          <Card
            id="courtney-rolnick"
            className="p-(--site-padding-base) border-base-200 hover:border-primary max-md:group-[.active]:border-primary max-md:group-[.active]:shadow-lg md:overflow-visible"
          >
            <div
              class="flex flex-col md:flex-row justify-between gap-(--site-padding-md) md:items-start"
            >
              <TeamBioCard
                name="Dr. Courtney Rolnick"
                jobTitle="PT, DPT, CMLDT - Founder/Practitioner"
                image={CourtneyImage}
              />
              <div class="space-y-4">
                <p class="h3">Hi, I'm Courtney.</p>
                <p>
                  I am a physical therapist who specializes in Post-Surgical manual lymphatic
                  drainage, manual lymphatic drainage massage for chronic health conditions, and
                  scar tissue work.
                </p>
                <p>
                  I am extremely passionate about what I do and helping guide my patients towards
                  their goals with compassion, patience, and an understanding of the complexities of
                  each individual's health journey. I am 100% patient-focused, which means I will
                  ALWAYS do what is best for my patients.
                </p>
                <p>
                  I received my Bachelor of Science in Dance from the University of
                  Wisconsin-Madison in 2006 and taught dance for 10 years after graduating.
                </p>
                <p>
                  In 2016, I graduated from Texas State University with my doctorate in Physical
                  Therapy. In my first few years working as a Physical Therapist, I was working
                  primarily with high-level athletes and chronic pain patients with a focus on
                  movement re-education and manual work, honing my skills as a hands-on practitioner
                  and learning soft tissue work and scar tissue manipulation.
                </p>
                <p>
                  In 2018, I received my Manual Lymphatic Drainage Massage certification (CMLDT)
                  from the Klose Institute in Seattle, Washington, and began working full-time as a
                  manual lymphatic drainage massage specialist, and have been doing that for the
                  past 7 years. I love working with and have experience with all sorts of
                  post-surgical patients, including: breast augmentation/lift/reduction,
                  abdominoplasty, BBL, DIEP flap, mastectomy, top surgery, face/neck lift,
                  liposuction, leg/arm/360 lifts, skin removal, orthopedic surgeries, and any other
                  elective or non-elective surgery. I also love and have extensive experience
                  working with patients living with: lipedema, lymphedema, cancer, autoimmune, long
                  covid, Lyme, Ehlers-Danlos syndrome, POTS, MCAS, and any other chronic
                  inflammatory conditions. While working with patients, I use a mix of manual
                  lymphatic drainage massage, scar tissue work, visceral work, breath work, and soft
                  tissue work as needed to assure you are getting the best outcomes as possible.
                </p>
                <p class="h3">
                  At Lymphatic Specialists of Madison, my focus is on helping people recovering from
                  surgery, cancer, and supporting those with lymphatic, autoimmune conditions, or
                  chronic inflammation issues.
                </p>
                <p>
                  I often refer to other practitioners in the community and enjoy working as a team
                  with other members of the health community for a truly holistic approach to
                  patient care. I enjoy working in this capacity because it engages my love for
                  critical thinking and helping people find the right direction for complex medical
                  issues.
                </p>
                <p>
                  In my other professional life, I own an IG vintage shop. In my free time, I enjoy
                  seeing live music, spending time with friends and family, exploring nature, and
                  hanging out with my partner Chris and our dog Lefty.
                </p>
                <div class="mt-6">
                  <a
                    href="https://booksy.com/en-us/1554807_lymphatic-specialists-of-madison_massage_39663_madison#ba_s=sh_1"
                    class="btn btn-primary"
                    target="_blank"
                    rel="noopener noreferrer">Book Now</a
                  >
                </div>
              </div>
            </div>
          </Card>
        </div>

        <!-- Elizabeth Gaffron -->
        <div class="lsa lsa-slide-up no-repeat group">
          <Card
            id="elizabeth-gaffron"
            className="p-(--site-padding-base) border-base-200 hover:border-primary max-md:group-[.active]:border-primary max-md:group-[.active]:shadow-lg md:overflow-visible"
          >
            <div
              class="flex flex-col md:flex-row justify-between gap-(--site-padding-md) md:items-start"
            >
              <TeamBioCard
                name="Elizabeth Gaffron"
                jobTitle="MS, OTR/L, CMLDT - Practitioner"
                image={ElizabethImage}
              />
              <div class="space-y-4">
                <p class="h3">Hi, I'm Elizabeth.</p>
                <p>
                  I am a licensed occupational therapist with 16 years of experience treating
                  patient populations across the lifespan living with persistent pain due to a
                  variety of health challenges and medical conditions. Drawing from my previous
                  background in massage therapy and social work, I utilize a wholistic approach
                  while collaborating with patients to determine a plan of care based on the unique
                  needs of each individual client. I am committed to building strong partnerships
                  with my patients offering personalized manual therapy and pain management
                  strategies to support pain reduction, management of swelling and inflammation,
                  enhanced mobility and support overall well-being.
                </p>
                <p class="h3">
                  My interest and passion for lymphatics comes from seeing how functionally
                  debilitating living with medical conditions that result in persistent inflammation
                  and swelling may be for an individual as well as an overall lack of effective
                  treatment options across healthcare environments.
                </p>
                <p>
                  I developed a strong desire and commitment to learn effective treatment
                  interventions for people experiencing lymphatic dysfunction and partner with
                  community healthcare providers who share a similar vision to improve patient
                  outcomes. I pursued additional manual therapy training in the areas of Manual
                  Lymphatic Drainage, Myofascial Trigger Point Release, Scar Massage, and
                  Craniosacral Therapy to enhance my abilities to help patients find relief and
                  return to meaningful activities. I received my Manual Lymphatic Drainage Massage
                  certification (CMLDT) from the Klose Institute in Lafayette, CO in 2025.
                </p>
                <p>
                  After earning my Master's of Occupational Therapy degree from the University of
                  New Mexico in 2008, I relocated to Chicago to join the interdisciplinary pain
                  management team at the Shirley Ryan Ability Lab, Center for Pain Management,
                  formally known as the Rehabilitation Institute of Chicago. I have presented
                  lectures and conducted workshops nationally and internationally on the role of
                  occupational therapy in the treatment of pain management. Additionally, I pursued
                  specialized training in the areas of pain neuroscience education, graded motor
                  imagery, pain reprocessing therapy, functional desensitization,
                  ergonomic/environmental assessment, pacing training, postural/body mechanics,
                  sensory integration methods, Mindfulness and adaptive movement-based therapies
                  including Yoga, QiGong, and Tai Chi. Prior to becoming an occupational therapist,
                  I provided case management services to support individuals living with chronic
                  mental health and substance use challenges in a variety of diverse settings.
                </p>
                <p>
                  My family and I recently relocated to the Madison area as we are long-time lovers
                  of the Driftless region. Beyond my work, I find fulfillment in hiking, yoga,
                  horseback riding, cooking, gardening and spending time with family and friends.
                </p>
                <div class="mt-6">
                  <a
                    href="https://booksy.com/en-us/1554807_lymphatic-specialists-of-madison_massage_39663_madison#ba_s=sh_1"
                    class="btn btn-primary"
                    target="_blank"
                    rel="noopener noreferrer">Book Now</a
                  >
                </div>
              </div>
            </div>
          </Card>
        </div>

        <!-- Sarah Nguyen -->
        <div class="lsa lsa-slide-up no-repeat group">
          <Card
            id="sarah-nguyen"
            className="p-(--site-padding-base) border-base-200 hover:border-primary max-md:group-[.active]:border-primary max-md:group-[.active]:shadow-lg md:overflow-visible"
          >
            <div
              class="flex flex-col md:flex-row justify-between gap-(--site-padding-md) md:items-start"
            >
              <TeamBioCard
                name="Sarah Nguyen (“Winn”)"
                jobTitle="OTR/L, CMLDT - Practitioner"
                image={SarahImage}
              />
              <div class="space-y-4">
                <p class="h3">Hi, I'm Sarah.</p>
                <p>
                  I am an Occupational Therapist. My 25-year career has spanned skilled nursing,
                  acute rehabilitation, long-term care, and home health, giving me broad experience
                  working with a wide range of diagnoses and stages of life.
                </p>
                <p>
                  As a 25-year practitioner of Tai Chi Chuan, I bring a holistic, Eastern-informed
                  lens to my work. This perspective has deepened my understanding of how movement,
                  breath, and the body's systems work together to support lymphatic function and
                  flow—and how I can better educate you on ways to support your own lymphatic
                  health. I have a special interest in neuromuscular and lymphatic disorders and in
                  understanding how profoundly every system of the body can be affected by
                  healthy—or disrupted—lymphatic function.
                </p>
                <p class="h3">
                  I often liken the lymphatic blockages we address through manual lymphatic drainage
                  to the energetic blockages addressed in Tai Chi and Qigong practice. For me, the
                  two are deeply connected.
                </p>
                <p>
                  My goal is to help you heal, move more comfortably through your daily activities,
                  and better understand your body. I see manual lymphatic drainage as one path
                  toward that goal, while also sharing practical knowledge and strategies that can
                  empower you to develop healthy, sustainable habits that support your lymphatic
                  system beyond the treatment room.
                </p>
                <p>
                  I have been a manual therapist throughout my career, weaving myofascial release,
                  soft tissue manipulation, and acupressure into my treatment of pain, anxiety, and
                  lymphatic flow. Early mentorship from several certified lymphedema specialists in
                  my home health and skilled nursing settings planted the seed for this specialty
                  long before I had a dedicated avenue to pursue it.
                </p>
                <p>
                  In 2026, I completed my Manual Lymphatic Drainage Therapist certification (CMLDT)
                  through Klose (Vodder technique) and joined Lymphatic Specialists of Madison under
                  the mentorship of Dr. Courtney, DPT—an opportunity that feels like coming home to
                  the practice I have long wanted to focus on exclusively.
                </p>
                <p>
                  I earned my degree in Occupational Therapy from the University of
                  Wisconsin–Madison in 2001 and have held my OTR/L in Wisconsin ever since. I am
                  also a certified Tai Chi instructor, teaching adaptive Tai Chi and Qigong for
                  older adults, alongside my personal practice in the full martial arts system of
                  Yangjia Michuan Taiji.
                </p>
                <p>
                  My husband is a social worker and fellow Tai Chi practitioner, and together we are
                  raising two daughters with a shared philosophy centered on whole-person
                  development—socially, emotionally, and spiritually. It is the same lens I bring to
                  my patients, and one that shapes our family life as much as my clinical work.
                </p>
                <div class="mt-6">
                  <a
                    href="https://booksy.com/en-us/1554807_lymphatic-specialists-of-madison_massage_39663_madison#ba_s=sh_1"
                    class="btn btn-primary"
                    target="_blank"
                    rel="noopener noreferrer">Book Now</a
                  >
                </div>
              </div>
            </div>
          </Card>
        </div>
      </div>
    </section>

    <!-- Join Our Team Section -->
    <section
      id="join-our-team"
      class="hero p-0 shadow-sm bg-cover bg-center md:bg-fixed"
      style={`background-image: url(${placeholderOneImage.src});`}
    >
      <div class="hero-overlay bg-black/60"></div>
      <div
        class="wrapper w-full p-(--site-padding-lg) flex flex-col items-start gap-(--site-padding-md)"
      >
        <h2 class="h1 text-secondary text-shadow-lg lsa lsa-slide-up no-repeat">Join Our Team</h2>
        <div
          class="grid grid-cols-1 md:grid-cols-2 gap-(--site-padding-base) md:gap-(--site-padding-xl) w-full"
        >
          <div class="space-y-4">
            <p class="h3 text-primary-content text-shadow-lg lsa lsa-slide-up delay-100 no-repeat">
              Enjoy working at one of the most well-regarded manual lymphatic drainage massage
              clinics in the Madison area.
            </p>
            <p class="lsa text-primary-content text-shadow-lg lsa-slide-up delay-200 no-repeat">
              Lymphatic Specialists of Madison is looking for at least one bright and talented
              Licensed Massage Therapist, PT, or OT to join our team. We are a clinic focused on
              manual lymphatic drainage massage (MLD) and post-op massage care, and are looking for
              someone excited to embark down that path with us.
            </p>
          </div>
          <div class="space-y-4">
            <p class="lsa text-primary-content text-shadow-lg lsa-slide-up delay-300 no-repeat">
              <strong>No non-compete agreement!</strong> We provide everything you need for success.
            </p>
            <p class="lsa text-primary-content text-shadow-lg lsa-slide-up delay-400 no-repeat">
              Looking for a commitment of 15-25 hours with full autonomy of scheduled days/hours.
              Patient load will be built up slowly based on demand.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Requirements Section -->
    <section id="requirements" class="bg-primary">
      <div
        class="wrapper container lg:max-w-screen-xl flex flex-col gap-(--site-padding-md) mx-auto text-primary-content"
      >
        <h2 class="h1 text-center text-primary-content lsa lsa-slide-up no-repeat">
          You're a Great Candidate If:
        </h2>
        <div
          class="grid grid-cols-1 md:grid-cols-2 gap-(--site-padding-base) w-full max-w-4xl mx-auto"
        >
          <ul class="list">
            <ListItem
              listItemClass="text-primary-content"
              number={1}
              text="You have at least two years of experience as a LMT, PT or OT (could work with someone with less experience if the fit was right)"
            />
            <ListItem
              listItemClass="text-primary-content"
              number={2}
              text="Are interested and excited about broadening your skills into manual lymphatic drainage massage, scar tissue work and post-op care"
            />
            <ListItem
              number={3}
              text="Are willing to get certified in MLD"
              listItemClass="md:hidden text-primary-content"
            />
            <ListItem
              number={4}
              text="Want to work in an environment that is nurturing and would foster career growth"
              listItemClass="md:hidden text-primary-content"
            />
            <ListItem
              number={5}
              text="Able to work in the Atwood area of Madison"
              listItemClass="md:hidden text-primary-content"
            />
          </ul>

          <ul class="list">
            <ListItem
              number={3}
              text="Are willing to get certified in MLD"
              listItemClass="hidden md:flex text-primary-content"
            />
            <ListItem
              number={4}
              text="Want to work in an environment that is nurturing and would foster career growth"
              listItemClass="hidden md:flex text-primary-content"
            />
            <ListItem
              number={5}
              text="Able to work in the Atwood area of Madison"
              listItemClass="hidden md:flex text-primary-content"
            />
          </ul>
        </div>
      </div>
    </section>

    <!-- What We Provide Section -->
    <ThemedSection id="what-we-provide">
      <div
        class="wrapper container lg:max-w-screen-xl flex flex-col gap-(--site-padding-md) mx-auto"
      >
        <h2 class="h1 text-center text-primary lsa lsa-slide-up no-repeat">What We Provide</h2>
        <p class="h4 text-center mx-auto lsa lsa-slide-up no-repeat">
          As a practitioner at our clinic, you are provided with everything that you need to have a
          successful career in massage therapy. This includes, but is not limited to:
        </p>

        <div
          class="grid grid-cols-1 md:grid-cols-2 gap-(--site-padding-md) w-full max-w-4xl mx-auto"
        >
          <ul class="list">
            <ListItem
              number={1}
              text="A clean and inviting facility in a very popular commercial district"
            />
            <ListItem number={2} text="Online booking, successful advertising, business cards" />
            <ListItem
              number={3}
              listItemClass="md:hidden"
              text="Supportive environment for you to grow as a therapist"
            />
            <ListItem number={4} listItemClass="md:hidden" text="Competitive fee schedule" />
          </ul>

          <ul class="list">
            <ListItem
              number={3}
              listItemClass="hidden md:flex"
              text="Supportive environment for you to grow as a therapist"
            />
            <ListItem number={4} listItemClass="hidden md:flex" text="Competitive fee schedule" />
          </ul>
        </div>
      </div>
    </ThemedSection>

    <!-- Important Notes Section -->
    <section
      id="important-notes"
      class="border-t-1 border-base-200 bg-gradient-to-b from-base-100 to-primary/5"
    >
      <div
        class="wrapper container lg:max-w-screen-xl flex flex-col gap-(--site-padding-md) mx-auto"
      >
        <h2 class="h1 text-center lsa lsa-slide-up no-repeat">Important Notes</h2>
        <div class="prose mx-auto">
          <p class="h4 text-center mx-auto lsa lsa-slide-up no-repeat">
            LMTs, PTs, and OTs are responsible for maintaining SOAP notes, accepting payments from
            clients, changing sheets between sessions, and keeping a clean and orderly treatment
            room.
          </p>
          <p class="text-center mx-auto lsa lsa-slide-up no-repeat">
            Our clinic focuses on and is known for providing MLD and post-op care, so our patients'
            needs vary greatly. We regularly treat patients with: autoimmune disease, cancer,
            lipedema, lymphedema, complicated medical histories, other chronic conditions, and
            generalized inflammation. Being comfortable with treating patients from a holistic
            perspective and being a part of their care team is an essential part of the job.
            Additional requirements include excellent communication skills, a warm disposition, and
            the ability to work well with our group of dedicated therapists.
          </p>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section id="contact-us" class="border-b-1 border-base-200 bg-primary/5">
      <div
        class="wrapper container lg:max-w-3xl flex flex-col gap-(--site-padding-base) mx-auto text-center"
      >
        <h2 class="h1 text-primary lsa lsa-slide-up no-repeat">Ready to Join Our Team?</h2>
        <p class="h4 mx-auto lsa lsa-slide-up delay-100 no-repeat">
          We'd love to hear from you. Get in touch to learn more about opportunities at Madison
          Lymphatics and Manual Therapy.
        </p>

        <div class="flex flex-wrap gap-2 justify-center lsa lsa-slide-up delay-200 no-repeat">
          <a href="/contact" class="btn btn-primary">Contact Us</a>
          <a href="tel:6083582082" class="btn btn-dash">Call (608) 358-2082</a>
        </div>

        <p class="text-sm mx-auto lsa lsa-slide-up delay-300 no-repeat">
          <em>
            <strong class="text-primary">COVID-19 considerations:</strong> All of our clients and therapists
            have the option to wear masks while in the clinic, including during sessions. All of our
            staff members have been fully vaccinated.
          </em>
        </p>
      </div>
    </section>
  </main>
</Layout>
